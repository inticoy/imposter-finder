# GitHub Actions에서는 이 파일 내용을 시크릿 ENV_FILE로 넣는다 (BOT_ENV는 workflow에서 prod로 고정)

# ── Discord ──────────────────────────────────────────
# dev=테스트 채널, prod=실제 채널
BOT_ENV=dev
DISCORD_BOT_TOKEN=
# 선택: 슬래시 명령을 이 서버에 바로 반영 (없으면 전역 동기화, 반영이 느림)
DISCORD_GUILD_ID=
DISCORD_CHANNEL_DEV=
DISCORD_CHANNEL_PROD=
# 선택: 고정 thread에 댓글로 보낼 때 (비우면 채널에 매치별 thread 생성)
DISCORD_THREAD_DEV=
DISCORD_THREAD_PROD=

# ── PUBG ─────────────────────────────────────────────
PUBG_API_KEY=
PUBG_PLATFORM=steam
# 이 시간보다 오래된 매치는 알림 후보에서 뺀다
PUBG_MAX_MATCH_AGE_HOURS=12
# 선택: 맥 serve의 수집 주기 (분). Actions는 cron-job.org 주기를 따른다
PUBG_POLL_INTERVAL_MINUTES=15
# 배그 이미지 리포트 전용 thread (기존 DISCORD_THREAD_*는 예전 글 리포트용)
DISCORD_THREAD_PUBG_DEV=
DISCORD_THREAD_PUBG_PROD=

# ── FC 온라인 ─────────────────────────────────────────
# openapi.nexon.com에서 발급. test_ 키는 하루 1,000회
NEXON_API_KEY=
# FC 결과를 보낼 thread (말말말-beta / 말말말 포럼의 "⚽ FC Online")
DISCORD_THREAD_FC_DEV=
DISCORD_THREAD_FC_PROD=

# ── 리그 오브 레전드 ─────────────────────────────────
# developer.riotgames.com Personal API Key (2분 100회)
RIOT_API_KEY=
DISCORD_THREAD_LOL_DEV=
DISCORD_THREAD_LOL_PROD=

# ── 모니터링 ─────────────────────────────────────────
# 선택: 수집 주기마다 Healthchecks.io 핑 (period 15분, grace 10분). 한 게임이라도 실패하면 /fail
HEALTHCHECK_IMPOSTER_FINDER_URL=
